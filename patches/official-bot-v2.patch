+    /** POST /getChat: read-only metadata lookup for one explicitly entered chat. */
+    public JSONObject getChat(String chatId) throws Exception {
+        if (chatId == null || chatId.trim().isEmpty() || chatId.length() > 180) {
+            throw new IllegalArgumentException("شناسه چت معتبر نیست");
+        }
+        JSONObject payload = new JSONObject();
+        payload.put("chat_id", chatId.trim());
+        return call("getChat", payload);
+    }
+
+    /** POST /getUpdates: one manual, read-only request; no background polling. */
+    public JSONObject getUpdates(int limit, String offsetId) throws Exception {
+        JSONObject payload = new JSONObject();
+        payload.put("limit", BotUpdatesPolicy.validateLimit(limit));
+        String offset = BotUpdatesPolicy.validateOffset(offsetId);
+        if (offset != null) payload.put("offset_id", offset);
+        return call("getUpdates", payload);
+    }
+
